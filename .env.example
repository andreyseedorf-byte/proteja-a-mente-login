# Copie este ficheiro para .env e preencha com os seus dados locais.
DB_HOST=localhost
DB_PORT=3306
DB_USER=seu_usuario_mysql
DB_PASSWORD=sua_senha_mysql
DB_NAME=cadastro_login
PORT=3000
NODE_ENV=development
# Gere um valor aleatório com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=TROQUE_ISTO
